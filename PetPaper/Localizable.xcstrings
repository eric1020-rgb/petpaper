          "stringUnit": {
            "state": "translated",
            "value": "WidgetKit may coalesce updates while the device is locked or the app is suspended, so a 2-hour cadence is best-effort. Use Demo (8s / ~20s on the widget) in Simulator to see pose changes sooner."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統可能合併更新（鎖定或 App 被暫停時），兩小時一次只是盡力而為。模擬器請用「預覽（8 秒）」；小工具大約每 20 秒換一個姿勢，較容易看到動作。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
