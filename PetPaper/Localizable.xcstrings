    "widget.install.steps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple does not allow third-party live wallpapers. Add the PetPaper widget: long-press the Home Screen → Edit → Add Widget → PetPaper → 桌面寵物. Optionally set your exported still image as the wallpaper behind it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 不容許第三方動態壁紙。請把寵物放到主畫面：長按主畫面 → 編輯 → 加入小工具 → 寵物壁紙 → 桌面寵物。也可把匯出的靜態壁紙設成小工具後面的背景。"
          }
        }
      }
    },
